<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Lanshu.Presenter.Cli</RootNamespace>
    <AssemblyName>hela</AssemblyName>
    <RollForward>Major</RollForward>
    <!-- The brand mark, so the download is recognisable in Explorer and the taskbar. -->
    <ApplicationIcon>../../build/appicon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>HelaPresenter CLI</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lanshu.Presenter.Core\Lanshu.Presenter.Core.csproj" />
  </ItemGroup>

</Project>
